# Backend Configuration
# Choose between Vertex AI (true) or Gemini API (false)
# If not set, defaults to true (Vertex AI)
GEMINI_USE_VERTEX_AI=true

# Vertex AI Configuration (when GEMINI_USE_VERTEX_AI=true)
# Required: Your Google Cloud Project ID with Vertex AI API enabled
GCP_PROJECT=your-gcp-project-id

# Optional: GCP region for Vertex AI (default: global)
GCP_LOCATION=global

# Gemini API Configuration (when GEMINI_USE_VERTEX_AI=false)
# Required when not using Vertex AI
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# OpenRouter Configuration (when --model starts with openrouter/)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
